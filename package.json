{
  "name": "@yurikong/hamibot-types",
  "version": "0.0.0",
  "description": "Type definitions for Hamibot",
  "keywords": [
    "hamibot",
    "types",
    "@types",
    "typescript"
  ],
  "homepage": "https://github.com/yurikong/hamibot-types#readme",
  "bugs": {
    "url": "https://github.com/yurikong/hamibot-types/issues",
    "email": "jackdu2013@163.com"
  },
  "license": "MIT",
  "author": "Jianqiang Du <jackdu2013@163.com> (https://github.com/yurikong)",
  "repository": {
    "type": "git",
    "url": "https://github.com/yurikong/hamibot-types.git"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check --ignore-unknown",
    "format:fix": "prettier . --write --ignore-unknown",
    "cz": "cz",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  }
}
